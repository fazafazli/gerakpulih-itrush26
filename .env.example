# Salin menjadi .env.local lalu isi nilainya. JANGAN commit nilai asli.
# Variabel tanpa awalan NEXT_PUBLIC_ hanya dipakai di server.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-key>
SUPABASE_SECRET_KEY=<secret-key>

# Gemini (ringkasan AI untuk terapis). Nama model tidak di-hardcode.
GEMINI_API_KEY=<gemini-api-key>
GEMINI_MODEL=<nama-model-gemini>

# Penanda tangan cookie pasien (acak, minimal 32 karakter), mis. hasil: openssl rand -base64 48
PASIEN_TOKEN_SECRET=<acak-minimal-32-karakter>

# Rahasia header untuk GET /api/keepalive (GitHub Action)
KEEPALIVE_SECRET=<acak-minimal-32-karakter>

# Akun demo terapis untuk tombol "Coba dengan akun demo"
DEMO_TERAPIS_EMAIL=<email-akun-demo>
DEMO_TERAPIS_PASSWORD=<kata-sandi-akun-demo>

# Alamat publik situs untuk link pasien, QR, dan WhatsApp (tanpa garis miring di akhir).
# Bila kosong, dipakai alamat permintaan (mis. localhost saat pengembangan).
APP_URL=https://<nama>.vercel.app
